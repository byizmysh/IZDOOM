{
  "format": "hblauncher.gpu-app",
  "abi": 1,
  "id": "izdoom",
  "name": "IZDOOM",
  "version": "0.17.1",
  "description": "GPU DOOM for NS2: full textures, original sprites/HUD, smooth level transitions and 80% stick sensitivity",
  "icon": "icon.png",
  "initialState": "state.bin",
  "data": "data.bin",
  "shaders": {
    "vertex": "app.vert.spv",
    "fragment": "app.frag.spv",
    "compute": "app.comp.spv"
  },
  "memory": {
    "initial": "memory.bin.deflate",
    "bytes": 33554432,
    "encoding": "deflate"
  },
  "computeSequence": {
    "begin": "begin.comp.spv",
    "after": "after.comp.spv",
    "repeat": 2
  }
}
